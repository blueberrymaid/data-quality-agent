# 复制为 .env 后填写（.env 不要提交）
# 1 = 使用规则化 mock 决策（离线可跑）；0 = 调用真实大模型接口
LLM_MOCK=1

# 任何 OpenAI 兼容服务均可，例如：
#   https://api.deepseek.com/v1   + deepseek-chat
#   https://api.openai.com/v1     + gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 密钥二选一：
#   (a) 直接写环境变量（该行不要提交到仓库）
#   LLM_API_KEY=sk-...
#   (b) 推荐：把密钥写到项目之外的文件（如 %USERPROFILE%\.dsh_llm_key），这里只写路径
LLM_API_KEY_FILE=~/.dsh_llm_key

# 生成参数
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800

# 成本估算用（美元 / 1K token）；deepseek-chat 官方价
LLM_PRICE_IN=0.00027
LLM_PRICE_OUT=0.0011
